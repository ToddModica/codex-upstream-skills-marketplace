{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/no-negative-echo.js\" SessionStart",
            "timeout": 5,
            "statusMessage": "Loading final-output hygiene..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/no-negative-echo.js\" SubagentStart",
            "timeout": 5,
            "statusMessage": "Loading final-output hygiene..."
          }
        ]
      }
    ]
  }
}
